#!/bin/sh
# rootless: files live under /var/jb. roothide: the shell already sees jbroot as "/".
PATH=/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH

for prefix in /var/jb ""; do
    helper="$prefix/usr/libexec/voidyhelper"
    app="$prefix/Applications/Voidy.app"
    if [ -f "$helper" ] && [ -d "$app" ]; then
        chown root:wheel "$helper" || exit 1
        chmod 6755 "$helper" || exit 1
        uicache="$prefix/usr/bin/uicache"
        if [ ! -x "$uicache" ]; then
            uicache=$(command -v uicache) || {
                echo "Voidy: uicache is missing. Install uikittools and configure Voidy again." >&2
                exit 1
            }
        fi
        # Re-register this app after every upgrade. Do not unregister it first:
        # that would remove its existing Home Screen placement.
        "$uicache" -p "$app" || {
            echo "Voidy: app icon registration failed. Configure Voidy again after fixing uicache." >&2
            exit 1
        }
        exit 0
    fi
done
echo "Voidy: installed app or helper is missing." >&2
exit 1
